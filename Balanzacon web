// =====================================================
// SETUP
// =====================================================
void setup()
{
  Serial.begin(115200);
  delay(300);
  Serial.println("\nESP32 - COMEDERO INTELIGENTE CON PAGINA WEB INTEGRADA");

  servoCompuerta.setPeriodHertz(50);
  servoCompuerta.attach(SERVO_PIN, 500, 2400);
  servoCompuerta.write(ANGULO_CERRADO);
  Serial.println("Servo inicializado; compuerta en posicion cerrada.");

  // HX711: celda vacia durante la tara.
  hx711.begin();
  Serial.println("Tara: deje la celda sin carga...");
  delay(800);
  const int muestrasTara = 15;
  int64_t suma = 0;
  for (int i = 0; i < muestrasTara; i++)
  {
    suma += hx711.readChannelRaw(CHAN_A_GAIN_128);
    delay(20);
  }
  offsetTara = (int32_t)(suma / muestrasTara);
  Serial.print("Offset de tara: ");
  Serial.println(offsetTara);
  Serial.println("HX711 listo.");

  // RFID
  SPI.begin(RFID_SCK, RFID_MISO, RFID_MOSI, RFID_SS);
  rfid.PCD_Init();
  Serial.println("RFID RC522 listo.");

  // Crear la red Wi-Fi propia del comedero.
  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);
  IPAddress ip(192, 168, 4, 1);
  IPAddress gateway(192, 168, 4, 1);
  IPAddress subnet(255, 255, 255, 0);
  WiFi.softAPConfig(ip, gateway, subnet);

  if (WiFi.softAP(ssid, password))
  {
    Serial.println("Punto de acceso Wi-Fi iniciado.");
    Serial.print("Red: ");
    Serial.println(ssid);
    Serial.print("Contrasena: ");
    Serial.println(password);
    Serial.print("Abrir pagina web en: http://");
    Serial.println(WiFi.softAPIP());
  }
  else
  {
    Serial.println("ERROR: no se pudo crear el punto de acceso Wi-Fi.");
  }

  // Configurar el servidor y la pagina web.
  server.on("/", HTTP_GET, paginaPrincipal);
  server.on("/estado", HTTP_GET, enviarEstado);
  server.onNotFound([]() {
    server.send(404, "text/plain", "Recurso no encontrado");
  });
  server.begin();
  Serial.println("Servidor web iniciado.");
  Serial.println("Conectate a ESP32_PROYECTO y abri http://192.168.4.1");
}

// =====================================================
// LOOP
// =====================================================
void loop()
{
  // Atender solicitudes de la pagina web sin detener sensores.
  server.handleClient();

  leerRFID();

  if (comiendo && millis() - ultimaDeteccionRFID > TIEMPO_SIN_RFID)
  {
    comiendo = false;
    Serial.println("Estado: NO COMIENDO (RFID ausente)");
  }

  if (millis() - ultimoPeso >= INTERVALO_PESO)
  {
    ultimoPeso = millis();
    leerPeso();
    controlarCompuerta();
  }
}
