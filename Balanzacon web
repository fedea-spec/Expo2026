// =====================================================
// COMEDERO INTELIGENTE - UN SOLO ESP32
// ESP32 clasico (ESP32-WROOM-32 / ESP32 Dev Module)
// HX711 + celda de carga + RFID RC522 + servomotor
// El mismo ESP32 crea la red Wi-Fi y aloja la pagina web.
// =====================================================

// ---------------- WIFI: PUNTO DE ACCESO ----------------
const char* ssid = "ESP32_PROYECTO";
const char* password = "12345678";

WebServer server(80);

// ---------------- HX711 ----------------
#define HX711_DATA 4
#define HX711_SCK  5
Adafruit_HX711 hx711(HX711_DATA, HX711_SCK);

const float FACTOR_CALIBRACION = 138.5f; // RAW por gramo
int32_t offsetTara = 0;
float pesoActual = 0.0f;       // gramos, peso estable
float pesoFiltrado = 0.0f;
bool filtroIniciado = false;
const float ALFA_FILTRO = 0.35f;
const float UMBRAL_CAMBIO_G = 1.5f;
const float UMBRAL_CERO_G = 4.0f;
const unsigned long INTERVALO_PESO = 50;
unsigned long ultimoPeso = 0;
bool primerPesoMostrado = false;
float pesoMostradoAnterior = 999999.0f;
void imprimirPeso(int32_t raw);

// ---------------- RFID RC522 ----------------
#define RFID_SS   21
#define RFID_RST  22
#define RFID_SCK  18
#define RFID_MISO 19
#define RFID_MOSI 23
MFRC522 rfid(RFID_SS, RFID_RST);
String uidDetectado = "";
bool comiendo = false;
unsigned long ultimaDeteccionRFID = 0;
const unsigned long TIEMPO_SIN_RFID = 3000;

// ---------------- SERVOMOTOR / COMPUERTA ----------------
#define SERVO_PIN 13
Servo servoCompuerta;
const int ANGULO_CERRADO = 18;   // Ajustar segun la mecanica real
const int ANGULO_ABIERTO = 82;   // Ajustar segun la mecanica real
const float LIMITE_ABRIR_G = 500.0f;
const float LIMITE_CERRAR_G = 550.0f; // Histeresis para evitar oscilaciones
const unsigned long TIEMPO_BAJO_LIMITE = 4000; // 4 segundos
bool compuertaAbierta = false;
bool contandoPesoBajo = false;
unsigned long inicioPesoBajo = 0;

// =====================================================
// RFID
// =====================================================
String obtenerUID()
{
  String uid = "";
  for (byte i = 0; i < rfid.uid.size; i++)
  {
    if (rfid.uid.uidByte[i] < 0x10) uid += "0";
    uid += String(rfid.uid.uidByte[i], HEX);
  }
  uid.toUpperCase();
  return uid;
}

void leerRFID()
{
  byte bufferATQA[2];
  byte bufferSize = sizeof(bufferATQA);
  MFRC522::StatusCode estado = rfid.PICC_WakeupA(bufferATQA, &bufferSize);
  if (estado != MFRC522::STATUS_OK && estado != MFRC522::STATUS_COLLISION) return;
  if (!rfid.PICC_ReadCardSerial()) return;

  String uidNuevo = obtenerUID();
  if (uidNuevo != uidDetectado)
  {
    uidDetectado = uidNuevo;
    Serial.print("RFID detectado: ");
    Serial.println(uidDetectado);
  }

  if (!comiendo)
  {
    comiendo = true;
    Serial.println("Estado: COMIENDO");
  }

  ultimaDeteccionRFID = millis();
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
}

// =====================================================
// PESO FILTRADO
// =====================================================
void imprimirPeso(int32_t raw)
{
  pesoMostradoAnterior = pesoActual;
  Serial.print("Peso estable: ");
  Serial.print(pesoActual, 2);
  Serial.print(" g | ");
  Serial.print(pesoActual / 1000.0f, 3);
  Serial.print(" kg | RAW: ");
  Serial.println(raw);
}

void leerPeso()
{
  int32_t raw = hx711.readChannelRaw(CHAN_A_GAIN_128);
  float pesoNuevo = (float)(raw - offsetTara) / FACTOR_CALIBRACION;

  if (fabsf(pesoNuevo) < UMBRAL_CERO_G)
    pesoNuevo = 0.0f;

  if (!filtroIniciado)
  {
    pesoFiltrado = pesoNuevo;
    pesoActual = pesoFiltrado;
    filtroIniciado = true;
  }
  else
  {
    pesoFiltrado += ALFA_FILTRO * (pesoNuevo - pesoFiltrado);
    if (fabsf(pesoFiltrado) < 0.8f)
      pesoFiltrado = 0.0f;

    // Banda muerta: cambios de 1 g o menos no alteran el peso estable.
    if (fabsf(pesoFiltrado - pesoActual) > UMBRAL_CAMBIO_G)
      pesoActual = pesoFiltrado;
  }

  if (!primerPesoMostrado)
  {
    primerPesoMostrado = true;
    imprimirPeso(raw);
  }
  else if (fabsf(pesoActual - pesoMostradoAnterior) > UMBRAL_CAMBIO_G)
  {
    imprimirPeso(raw);
  }
}

// =====================================================
// CONTROL DE LA COMPUERTA
// Abre si peso < 500 g durante 4 segundos continuos.
// Cierra cuando el peso llega a 550 g o mas.
// =====================================================
void controlarCompuerta()
{
  unsigned long ahora = millis();

  if (!compuertaAbierta)
  {
    if (pesoActual < LIMITE_ABRIR_G)
    {
      if (!contandoPesoBajo)
      {
        contandoPesoBajo = true;
        inicioPesoBajo = ahora;
        Serial.println("Peso inferior a 500 g; iniciando espera de 4 segundos...");
      }
      else if (ahora - inicioPesoBajo >= TIEMPO_BAJO_LIMITE)
      {
        servoCompuerta.write(ANGULO_ABIERTO);
        compuertaAbierta = true;
        contandoPesoBajo = false;
        Serial.println("COMPUERTA ABIERTA: peso bajo durante 4 segundos.");
      }
    }
    else
    {
      if (contandoPesoBajo)
        Serial.println("Peso recuperado antes de 4 segundos; conteo cancelado.");
      contandoPesoBajo = false;
    }
  }
  else
  {
    if (pesoActual >= LIMITE_CERRAR_G)
    {
      servoCompuerta.write(ANGULO_CERRADO);
      compuertaAbierta = false;
      contandoPesoBajo = false;
      Serial.println("COMPUERTA CERRADA: alimento recuperado hasta 550 g.");
    }
  }
}

// =====================================================
// API LOCAL: ENVIAR DATOS A LA PAGINA WEB
// =====================================================
void enviarEstado()
{
  bool animalPresente = comiendo;

  unsigned long segundosRestantes = 0;
  if (!compuertaAbierta && contandoPesoBajo)
  {
    unsigned long transcurrido = millis() - inicioPesoBajo;
    if (transcurrido < TIEMPO_BAJO_LIMITE)
      segundosRestantes = (TIEMPO_BAJO_LIMITE - transcurrido + 999) / 1000;
  }

  String json;
  json.reserve(220);
  json = "{";
  json += "\"uid\":\"" + uidDetectado + "\",";
  json += "\"comiendo\":";
  json += (animalPresente ? "true" : "false");
  json += ",\"peso_g\":" + String(pesoActual, 2);
  json += ",\"peso_kg\":" + String(pesoActual / 1000.0f, 2);
  json += ",\"compuerta_abierta\":";
  json += (compuertaAbierta ? "true" : "false");
  json += ",\"contando_peso_bajo\":";
  json += (contandoPesoBajo ? "true" : "false");
  json += ",\"segundos_restantes\":" + String(segundosRestantes);
  json += "}";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json; charset=utf-8", json);
}

